generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
}

model Category {
  id       String @id @default(cuid())
  name     String @unique
  products Product[]
}
model Product {
  id          String @id @default(cuid())
  name        String
  description String @default("")
  image       String @default("")
  active      Boolean @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  variants    Variant[]
}
model Variant {
  id        String @id @default(cuid())
  productId String
  sku       String @unique
  size      String
  color     String
  price     Int
  stock     Int
  active    Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id])
  @@unique([productId, size, color])
}
model Order {
  id             String @id @default(cuid())
  idempotencyKey String @unique
  requestHash    String
  accessHash     String
  customerName   String
  email          String
  address        String
  currency       String
  total          Int
  status         String @default("PENDING")
  createdAt      DateTime @default(now())
  items          OrderItem[]
  events         PaymentEvent[]
}
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String
  name      String
  sku       String
  size      String
  color     String
  quantity  Int
  unitPrice Int
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
model PaymentEvent {
  id      String @id
  orderId String
  outcome String
  order   Order @relation(fields: [orderId], references: [id])
}

model SystemSetting {
  key   String @id
  value String
}
